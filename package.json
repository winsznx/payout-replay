{
  "name": "payout-replay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @payout-replay/core --filter @payout-replay/sdk test",
    "test:contracts": "cd contracts && forge test -vv",
    "test:api": "pnpm --filter @payout-replay/api test"
  }
}
