{
  "name": "@payout-replay/adapters-evm",
  "version": "0.1.0",
  "description": "Portaldot V3 EVM (pallet-revive) adapter for Payout Replay: PayoutExecutor calls and receipt verification",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "cd ../../contracts && forge build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@payout-replay/core": "workspace:*",
    "viem": "^2.57.16"
  }
}
