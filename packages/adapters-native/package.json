{
  "name": "@payout-replay/adapters-native",
  "version": "0.1.0",
  "description": "Portaldot V3 native runtime adapter for Payout Replay: transfer_keep_alive extrinsics and event-attributed proof",
  "license": "MIT",
  "author": "winsznx",
  "homepage": "https://github.com/winsznx/payout-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/payout-replay.git",
    "directory": "packages/adapters-native"
  },
  "bugs": {
    "url": "https://github.com/winsznx/payout-replay/issues"
  },
  "keywords": [
    "payouts",
    "substrate",
    "polkadot-js",
    "portaldot"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@payout-replay/core": "workspace:*",
    "@polkadot/api": "^17.0.2",
    "@polkadot/api-augment": "^17.0.2",
    "@polkadot/types": "^17.0.2",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3"
  }
}
