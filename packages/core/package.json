{
  "name": "@payout-replay/core",
  "version": "0.1.0",
  "description": "Manifest canonicalisation, reconciliation and fail-closed recovery planning for Payout Replay",
  "license": "MIT",
  "author": "winsznx",
  "homepage": "https://github.com/winsznx/payout-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/payout-replay.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/winsznx/payout-replay/issues"
  },
  "keywords": [
    "payouts",
    "reconciliation",
    "treasury",
    "dao",
    "portaldot"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
