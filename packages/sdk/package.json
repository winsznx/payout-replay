{
  "name": "@payout-replay/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Payout Replay: manifest validation, reconciliation, recovery planning, chain adapters and a typed REST client",
  "license": "MIT",
  "author": "winsznx",
  "homepage": "https://github.com/winsznx/payout-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/payout-replay.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/winsznx/payout-replay/issues"
  },
  "keywords": [
    "payouts",
    "reconciliation",
    "treasury",
    "dao",
    "portaldot",
    "substrate",
    "evm",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@payout-replay/adapters-evm": "workspace:*",
    "@payout-replay/adapters-native": "workspace:*",
    "@payout-replay/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
